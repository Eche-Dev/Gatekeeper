  "payloads": [
    {
      "id": "ho-sqli-001",
      "rule": "sqli",
      "payload": "1' AND 1=1-- -",
      "note": "tautologia con cierre de comentario"
    },
    {
      "id": "ho-sqli-002",
      "rule": "sqli",
      "payload": "') OR ('x'='x",
      "note": "cierre de parentesis + comparacion de literales",
      "documented_miss": "compara dos literales de texto entre comillas (`'x'='x`); la regla de tautologia exige digitos o un token sin comillas"
    },
    {
      "id": "ho-sqli-003",
      "rule": "sqli",
      "payload": "1 GROUP BY 3-- -",
      "note": "sondeo de columnas por GROUP BY en vez de ORDER BY"
    },
    {
      "id": "ho-sqli-004",
      "rule": "sqli",
      "payload": "1 HAVING 1=1-- -",
      "note": "HAVING con tautologia"
    },
    {
      "id": "ho-sqli-005",
      "rule": "sqli",
      "payload": "id=1 UNION SELECT null,null,null,null,null",
      "note": "UNION con columnas nulas"
    },
    {
